---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import { Image } from "astro:assets";
import portrait from "@assets/images/vtsakalos_round.png";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
---

<Layout title={`${SITE.title} | About`}>
  <Header activeNav="about" />
  <Main pageTitle="About">
    <section id="about" class="prose max-w-full">
      <Image class="portrait" src={portrait} alt="Vasileios Tsakalos" />
      <h3>I am a...</h3>
      <p>
        <span class="highlight">
          Data Scientist. Applied ML/GenAI Engineer.
        </span>
      </p>
      <p>
        <span class="highlight">
          Builder of production AI systems, agentic workflows, and evaluation-driven products.
        </span>
      </p>
      <p>
        Over the last eight years I’ve translated ambiguous business questions into data products, ML pipelines, and GenAI systems that ship and scale.
      </p>
      <p>
        My work spans LLMs, agentic architectures, multi-modal pipelines, experimentation, and platform delivery across UBS, EF Education First, and personal ventures.
      </p>
      <p>
        I’m especially interested in the intersection of product strategy, rigorous evaluation, and pragmatic engineering.
      </p>
      <Hr />
      <h3>Details</h3>
      <p>
        Visit my <LinkButton
          href="https://www.linkedin.com/in/vasileiostsakalos/"
          title="Vasileios Tsakalos on LinkedIn"
          ariaLabel="Vasileios Tsakalos on LinkedIn"
          newTab>LinkedIn Profile</LinkButton
        > for a fuller timeline and recent work.
      </p>
      <p>
        Reach out at <LinkButton
          href="mailto:vasileios.m.tsakalos@gmail.com"
          title="Send an email to Vasileios Tsakalos"
          ariaLabel="Send an email to Vasileios Tsakalos"
          >vasileios.m.tsakalos@gmail.com</LinkButton
        > for collaborations or consulting.
      </p>
      <Hr />
      <h3>Support</h3>
      <p>
        If you would like to support my work please consider one of the
        following options:
      </p>
      <ul>
        <li>
          <LinkButton
            href="https://github.com/sponsors/VasTsak"
            title="Support Vasileios Tsakalos via Github"
            disabled
            >Github Sponsors (coming soon)
          </LinkButton>
        </li>
        <li>
          <LinkButton
            href="https://buy.stripe.com/28obMAdue2or07udQR"
            title="Support Vasileios Tsakalos via Stripe (monthly subscription)"
            >Stripe (monthly subscription)
          </LinkButton>
        </li>
        <li>
          <LinkButton
            href="https://donate.stripe.com/9AQcQE61M6EHcUg9AA"
            title="Support Vasileios Tsakalos via Stripe (one-time donation)"
            >Stripe (one-time donation)
          </LinkButton>
        </li>
        <li>
          <LinkButton
            href="paypal.me/vtsakalos"
            title="Support Vasileios Tsakalos via PayPal (one-time donation)"
            >PayPal (one-time donation)
          </LinkButton>
        </li>
        <li>
          <LinkButton
            href="https://ko-fi.com/gpiskas"
            title="Support Vasileios Tsakalos via Ko-Fi"
            >Buy me a coffee (subscription or donation)
          </LinkButton>
        </li>
      </ul>
    </section>
  </Main>
  <Footer />

  <style>
    #about p {
      @apply m-2;
    }
    .last {
      @apply text-right text-xl;
    }
    .portrait {
      @apply float-none h-40 w-40 rounded-full object-cover sm:float-right;
    }
  </style>
</Layout>
