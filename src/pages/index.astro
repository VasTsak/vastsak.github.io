---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import PostCard from "@components/PostCard";
import ProjectCard from "@components/ProjectCard.astro";
import getSortedPosts from "@utils/getSortedPosts";
import Main from "@layouts/Main.astro";
import { getPosts, getProjects } from "@utils/collections";

const posts = await getPosts();
const projects = await getProjects();

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const sortedProjects = getSortedPosts(projects);
const featuredProjects = sortedProjects.slice(0, 3);

let featuredPostsDisplayCount = Math.min(featuredPosts.length, 3);
let recentPostsDisplayCount = Math.min(recentPosts.length, 5 - featuredPostsDisplayCount);
---

<Layout>
  <Header />
  <Main>
    <section id="services" class="prose max-w-full">
      <div class="hero-card rounded-2xl border border-skin-line bg-skin-card/70 p-6 shadow-sm sm:p-8">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-skin-accent">
          Data Scientist & Applied ML/GenAI Engineer
        </p>
        <h2 class="mb-4 text-3xl font-semibold leading-tight">
          Building production AI systems that turn ideas into measurable impact.
        </h2>
        <p class="mb-6 text-lg leading-relaxed">
          I work at the intersection of product strategy, rigorous evaluation, and pragmatic engineering—shipping GenAI, agentic, and ML systems that are used in the real world.
        </p>
        <div class="flex flex-wrap gap-3">
          <LinkButton href="/projects/" className="inline-flex items-center rounded-full border border-skin-accent px-4 py-2 font-medium text-skin-accent transition hover:bg-skin-accent hover:text-skin-inverted">
            Explore Projects
          </LinkButton>
          <LinkButton href="/about/" className="inline-flex items-center rounded-full border border-skin-line px-4 py-2 font-medium transition hover:border-skin-accent hover:text-skin-accent">
            About Me
          </LinkButton>
          <LinkButton href="/cv.pdf" newTab className="inline-flex items-center rounded-full border border-skin-line px-4 py-2 font-medium transition hover:border-skin-accent hover:text-skin-accent">
            Download CV
          </LinkButton>
        </div>
      </div>
    </section>

    {featuredProjects.length > 0 && (
      <section id="featured-projects" class="pt-8">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-2xl font-semibold tracking-wide">Featured Projects</h2>
          <LinkButton href="/projects/" className="text-sm font-medium text-skin-accent hover:underline">
            View all
          </LinkButton>
        </div>
        <ul>
          {featuredProjects.map(({ data, slug }) => (
            <ProjectCard href={`/projects/${slug}/`} frontmatter={data} />
          ))}
        </ul>
      </section>
    )}

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured-posts">
            <h2>Featured Posts</h2>
            <ul>
              {featuredPosts.map(
                ({ data, slug }, index) =>
                  index < featuredPostsDisplayCount && (
                    <PostCard href={`/posts/${slug}/`} frontmatter={data} />
                  )
              )}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }
    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <h2>Recent Posts</h2>
          <ul>
            {recentPosts.map(
              ({ data, slug }, index) =>
                index < recentPostsDisplayCount && (
                  <PostCard href={`/posts/${slug}/`} frontmatter={data} />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="all-posts-btn-wrapper">
      <LinkButton href="/posts/">
        All Posts
        <svg xmlns="http://www.w3.org/2000/svg"><path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"></path></svg>
      </LinkButton>
    </div>
  </Main>
  <Footer />
</Layout>

<style>
  /* ===== Featured & Recent Posts Sections ===== */
  #featured-posts,
  #recent-posts {
    @apply pb-6 pt-6;
  }
  #featured-posts h2,
  #recent-posts h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }
  .hero-card {
    @apply backdrop-blur-sm;
  }
</style>
