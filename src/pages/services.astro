---
import { SITE } from "@config";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import LinkButton from "@components/LinkButton.astro";
---

<Layout title={`${SITE.title} | Services`}>
  <Header activeNav="services" />
  <Main pageTitle="Services">
    <section id="services" class="prose max-w-full">
      <p>
        Please reach out at <LinkButton
          href="mailto:vasileios.m.tsakalos@gmail.com"
          title="Send an email to Vasileios Tsakalos"
          newTab>vasileios.m.tsakalos@gmail.com</LinkButton
        > with a description of your needs and an estimate in budget, time and scale.
        I can work with you on an individual basis or integrate in your existing
        organization.
      </p>
      <h3 id="consulting">Consulting:</h3>
      <ul>
        <li>GenAI, LLM, and agentic system design</li>
        <li>Multi-modal pipelines for text, speech, and documents</li>
        <li>Evaluation harnesses, observability, and safety guardrails</li>
        <li>ML platforms, experimentation, model governance, and MLOps</li>
        <li>Data pipelines, cloud-native delivery, and platform enablement</li>
        <li>Stakeholder discovery and technical translation for business teams</li>
      </ul>
      <h3 id="projects">Projects:</h3>
      <ul>
        <li>RAG chatbots and retrieval quality improvements</li>
        <li>Agentic workflows for decision support and automation</li>
        <li>Explainable ML and monitoring systems</li>
        <li>Custom web apps and AI-powered products</li>
        <li>Data strategy and analytics enablement</li>
      </ul>
    </section>
  </Main>
  <Footer />
</Layout>
